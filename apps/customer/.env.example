# Customer portal — organisation is resolved from env / host / ?tenant=, not the login form.
NEXT_PUBLIC_TENANT_SLUG=trustwood-enterprise
# Optional SSR/PWA fallback only. Live UI uses GET /api/public/tenants/:slug → brand.displayName || tenant.name
# NEXT_PUBLIC_TENANT_NAME=
# Loopback only — public traffic enters via nginx (HTTPS), not :3010
GATEWAY_SERVICE_URL=http://127.0.0.1:3010/admin

# Google Sign-In — browser-visible ID token client id (public-safe). Same value as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
