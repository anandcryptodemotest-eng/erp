generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Gateway owns: Users, Tenants, Licenses, Sessions
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  emailVerified   Boolean   @default(false)
  phoneNormalized String?   @unique
  phoneVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  credentials   AuthCredential[]
  tenants       TenantUser[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  notifications Notification[]
  dashboards    DashboardPreference[]
}

/**
 * Per-user dashboard layout preference. Config is a JSON array of placed
 * widgets ({ type, x, y, w, h, config? }). Storing a widget here NEVER grants
 * access — the server-side resolver re-filters against the user's current
 * modules + capabilities on every read.
 */
model DashboardPreference {
  id        String   @id @default(cuid())
  userId    String
  portal    String   @default("ADMIN") // ADMIN | CUSTOMER
  config    Json     // DashboardPlacement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, portal])
  @@index([userId])
}

enum CredentialType {
  PASSWORD
  GOOGLE
  PASSKEY
  PHONE
}

/**
 * Extensible authentication credential. A user can hold at most one credential
 * of a given type (one PASSWORD, one GOOGLE, one PASSKEY).
 *
 * providerId stores the provider subject (e.g. Google `sub`); future providers
 * (Microsoft, Apple, SAML) plug in as new CredentialType values — no schema change.
 */
model AuthCredential {
  id           String         @id @default(cuid())
  userId       String
  type         CredentialType
  providerId   String? // Google `sub` / future MS or Apple subject
  passwordHash String? // Argon2id (PASSWORD type only)
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, providerId]) // one Google account per provider subject
  @@unique([userId, type])     // one PASSWORD / one GOOGLE / one PASSKEY per user
  @@index([userId])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// @deprecated Use TenantDomain mappings for portal routing.
  domain    String?  @unique
  plan      String   @default("starter")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 TenantUser[]
  domains               TenantDomain[]
  licenses              ModuleLicense[]
  settings              TenantSetting[]
  capabilities          TenantCapability[]
  invitations           Invitation[]
  notifications         Notification[]
  branches              Branch[]
  auditEvents           AuditEvent[]
  reconciliationRecords ReconciliationRecord[]
  integrations          TenantIntegration[]
  integrationSecrets    TenantIntegrationSecret[]
  otpChallenges         OtpChallenge[]
}

model TenantDomain {
  id                String   @id @default(cuid())
  tenantId          String
  hostname          String   @unique
  portalType        String   @default("CUSTOMER")
  isPrimary         Boolean  @default(false)
  isVerified        Boolean  @default(false)
  certificateStatus String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hostname, portalType, isVerified])
}

/**
 * Operational enablement (distinct from TenantSetting branding/config).
 */
model TenantCapability {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  address   String?
  city      String?
  phone     String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserBranch[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model UserBranch {
  id        String  @id @default(cuid())
  tenantId  String
  userId    String
  branchId  String
  isPrimary Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId, userId])
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("USER")
  // OMS roles also accepted as string: SUPER_ADMIN | ORG_ADMIN | BRANCH_ADMIN |
  // SALES_EXECUTIVE | PRICING_EXECUTIVE | DISPATCH_EXECUTIVE | DELIVERY_EXECUTIVE | VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
}

model ModuleLicense {
  id          String    @id @default(cuid())
  tenantId    String
  moduleId    String
  plan        String    @default("basic")
  maxUsers    Int       @default(5)
  isActive    Boolean   @default(true)
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  purchasedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
}

model TenantSetting {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

/// Per-tenant external connector (non-secret config + status). Secrets live in TenantIntegrationSecret.
model TenantIntegration {
  id           String   @id @default(cuid())
  tenantId     String
  provider     String // FAST2SMS_WHATSAPP
  status       String   @default("DISCONNECTED") // DISCONNECTED | CONNECTED | ERROR
  config       Json? // wabaId, phoneNumberId, templates snapshot, …
  lastError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

/// Encrypted connector secrets (AES-256-GCM). Never expose ciphertext via APIs.
model TenantIntegrationSecret {
  id         String   @id @default(cuid())
  tenantId   String
  provider   String // FAST2SMS_WHATSAPP
  keyName    String // api_key
  ciphertext String
  iv         String
  authTag    String
  lastFour   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, keyName])
  @@index([tenantId])
}

model OtpChallenge {
  id                String    @id @default(cuid())
  tenantId          String
  phoneNormalized   String
  codeHash          String
  purpose           String // LOGIN | VERIFY_LINK | REGISTER_CUSTOMER
  expiresAt         DateTime
  attemptCount      Int       @default(0)
  consumedAt        DateTime?
  providerRequestId String?
  createdAt         DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, phoneNormalized, createdAt])
  @@index([tenantId, phoneNormalized, purpose])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  lastUsedAt DateTime?
  device     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       String    @default("USER")
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  invitedBy  String
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json? // optional extra payload (resourceId, resourceType, etc.)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
}

// ── Marketing / Grocery Extensions ──────────────────────────────────────────

model Banner {
  id        String    @id @default(cuid())
  tenantId  String
  title     String
  imageUrl  String
  linkUrl   String?
  type      String    @default("HOME") // HOME | PROMOTIONAL | CATEGORY | PRODUCT
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, type, isActive])
}

model Coupon {
  id             String    @id @default(cuid())
  tenantId       String
  code           String
  description    String?
  type           String // PERCENTAGE | FLAT_AMOUNT | FREE_DELIVERY
  value          Float
  minOrderAmount Float?
  maxDiscount    Float? // cap for PERCENTAGE coupons
  usageLimit     Int?
  usageCount     Int       @default(0)
  perUserLimit   Int       @default(1)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  usages CouponUsage[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  tenantId String
  userId   String
  orderId  String
  discount Float
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([couponId])
}

model FCMToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  token     String
  platform  String // ANDROID | IOS | WEB
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([tenantId, userId])
}

/// SaaS operator — not a TenantUser. Future: mfaEnabled, failedLoginCount, lockedUntil.
model PlatformOperator {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         String    @default("PLATFORM_VIEWER")
  // PLATFORM_OWNER | PLATFORM_ADMIN | PLATFORM_SUPPORT | PLATFORM_VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs     PlatformAuditLog[]
  refreshTokens PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id         String   @id @default(cuid())
  operatorId String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  operatorId String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([operatorId, createdAt])
  @@index([entityType, entityId])
}

model AuditEvent {
  id            String   @id @default(cuid())
  tenantId      String
  actorId       String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  requestId     String?
  correlationId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action, createdAt])
}

model ReconciliationRecord {
  id            String   @id @default(cuid())
  tenantId      String
  operation     String
  targetService String
  path          String
  method        String   @default("POST")
  payload       Json?
  idempotencyKey String
  status        String   @default("PENDING") // PENDING | FAILED | SUCCEEDED
  attempts      Int      @default(0)
  lastError     String?
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, nextRetryAt])
  @@index([tenantId, createdAt])
}

// ── Platform: Asset Store (first-class capability, not owned by Communication) ──

model Asset {
  id           String   @id @default(cuid())
  tenantId     String
  type         String // DOCUMENT | MEDIA | IMAGE | VIDEO | VOICE | FILE | REPORT
  fileName     String
  mimeType     String
  fileSize     Int
  checksum     String?
  storageType  String   @default("LOCAL") // LOCAL | S3 | MINIO (future)
  storagePath  String // internal — never exposed to clients
  url          String // public URL for serving
  thumbnailUrl String?
  duration     Int? // seconds (voice/video)
  width        Int?
  height       Int?
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, type])
}

// ── Communication: Conversations ──────────────────────────────────

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  type          String   @default("DIRECT") // DIRECT | GROUP | SUPPORT | BROADCAST
  channel       String   @default("IN_APP") // IN_APP | EMAIL | SMS | PUSH | WHATSAPP
  status        String   @default("OPEN") // OPEN | ARCHIVED | LOCKED | DELETED
  title         String?
  avatarUrl     String?
  description   String?
  contextModule String   @default("general") // "sales" | "procurement" | "workflow" | ...
  contextEntity String   @default("General") // "SalesOrder" | "TaskInstance" | ...
  contextId     String? // "SO-10012" | "task-id" | ...
  contextLabel  String? // Display snapshot; ownership is revalidated by the owning module.
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  summaries    ConversationSummary[]
  policy       ConversationPolicy?

  @@index([tenantId])
  @@index([tenantId, contextModule, contextEntity, contextId])
  @@index([tenantId, status])
}

model ConversationPolicy {
  id                      String   @id @default(cuid())
  conversationId          String   @unique
  tenantId                String
  visibility              String   @default("PARTICIPANTS") // PARTICIPANTS | TENANT | CONTEXT_MEMBERS
  allowedParticipantTypes String[] @default([])
  canSend                 String[] @default([])
  canEdit                 String[] @default([])
  canDelete               String[] @default([])
  canClose                String[] @default([])
  retentionDays           Int?
  allowExport             Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ConversationParticipant {
  id              String    @id @default(cuid())
  conversationId  String
  participantType String    @default("USER") // USER | STAFF | CUSTOMER | SUPPLIER | PARTNER | TEAM | ROLE | SYSTEM | BOT
  participantId   String // identity or tenant-scoped business-entity ID
  role            String    @default("MEMBER") // ADMIN | MEMBER
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  lastReadAt      DateTime?
  mutedUntil      DateTime?
  isArchived      Boolean   @default(false)
  isPinned        Boolean   @default(false)
  isFavorite      Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, participantType, participantId])
  @@index([participantType, participantId])
}

// ── Communication: Messages ───────────────────────────────────────

model Message {
  id              String    @id @default(cuid())
  conversationId  String
  senderType      String    @default("USER") // USER | SYSTEM
  senderId        String
  type            String    @default("TEXT") // TEXT | VOICE | IMAGE | DOCUMENT | VIDEO | AUDIO | LOCATION | CONTACT | SYSTEM
  text            String?
  contextModule   String?
  contextEntity   String?
  contextId       String?
  replyToId       String?
  forwardedFromId String?
  isDeleted       Boolean   @default(false)
  deletedBy       String?
  deletedFor      String[]  @default([])
  editedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversation  Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo       Message?             @relation("MessageReply", fields: [replyToId], references: [id])
  replies       Message[]            @relation("MessageReply")
  forwardedFrom Message?             @relation("MessageForward", fields: [forwardedFromId], references: [id])
  forwardedTo   Message[]            @relation("MessageForward")
  attachments   MessageAttachment[]
  reactions     MessageReaction[]
  readReceipts  MessageReadReceipt[]

  @@index([conversationId, createdAt])
  @@index([senderType, senderId])
  @@index([contextModule, contextEntity, contextId])
}

model MessageAttachment {
  id           String  @id @default(cuid())
  messageId    String
  assetRef     Json // Strongly typed as AssetRef { type, id, version } at app layer
  fileName     String
  mimeType     String
  fileSize     Int
  duration     Int? // seconds (voice/video)
  width        Int?
  height       Int?
  thumbnailUrl String?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

// ── Communication: Presence (v1 in Communication; future: Identity) ──

model Presence {
  id         String    @id @default(cuid())
  userId     String    @unique
  tenantId   String
  status     String    @default("OFFLINE") // ONLINE | AWAY | OFFLINE
  lastSeenAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
}

// ── Communication: AI ────────────────────────────────────────────

model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  tenantId       String
  type           String   @default("SUMMARY") // SUMMARY | DECISIONS
  summary        String
  decisions      String[] @default([])
  openQuestions  String[] @default([])
  actionItems    Json? // [{ assignee, task, dueDate }]
  messageRange   Json // { fromMessageId, toMessageId, fromCreatedAt, toCreatedAt }
  generatedBy    String // "AI" | userId
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([tenantId])
}
