generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Sales service owns: Customers, Leads, Opportunities, Quotes, Orders, Returns

model Customer {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  creditLimit    Float     @default(0)
  paymentTerms   Int       @default(0)
  customerGroup  String?
  priceListId    String?
  wallet         Float     @default(0)
  isBlocked      Boolean   @default(false)
  blockedReason  String?
  blockedAt      DateTime?
  isActive       Boolean   @default(true)
  /// Gateway User.id for B2B/customer portal login
  portalUserId   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders         SalesOrder[]
  salesRequests  SalesRequest[]
  quotes         Quote[]
  opportunities  Opportunity[]
  returns        SalesReturn[]
  addresses      CustomerAddress[]

  @@unique([tenantId, portalUserId])
  @@index([tenantId])
  @@index([tenantId, portalUserId])
}

/// Customer intent document (SREQ). Converted 1:1 to a SalesOrder — never a status ladder.
model SalesRequest {
  id                  String   @id @default(cuid())
  tenantId            String
  requestNumber       String
  customerId          String
  userId              String
  status              String   @default("OPEN") // OPEN | CONVERTED | REJECTED | CANCELLED
  salesOrderId        String?  @unique
  isOnlineOrder       Boolean  @default(true)
  deliveryAddressId   String?
  deliveryAddressText String?
  deliveryFee         Float    @default(0)
  paymentMethod       String   @default("COD")
  paymentStatus       String   @default("PENDING")
  couponId            String?
  couponDiscount      Float    @default(0)
  subtotal            Float
  tax                 Float    @default(0)
  total               Float
  notes               String?
  rejectReason        String?
  convertedAt         DateTime?
  convertedBy         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer   Customer           @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  items      SalesRequestItem[]

  @@unique([tenantId, requestNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

model SalesRequestItem {
  id              String  @id @default(cuid())
  salesRequestId  String
  productId       String
  productName     String
  variantId       String?
  quantity        Int
  unitPrice       Float
  taxRate         Float   @default(0)
  total           Float

  salesRequest SalesRequest @relation(fields: [salesRequestId], references: [id], onDelete: Cascade)

  @@index([salesRequestId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String   @default("Home") // Home | Work | Other
  line1      String
  line2      String?
  city       String
  state      String?
  pincode    String
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
}

model Lead {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  company    String?
  email      String?
  phone      String?
  source     String?
  status     String   @default("NEW") // NEW, CONTACTED, QUALIFIED, DISQUALIFIED
  notes      String?
  assignedTo String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  opportunities Opportunity[]

  @@index([tenantId])
}

model Opportunity {
  id            String    @id @default(cuid())
  tenantId      String
  leadId        String?
  customerId    String?
  title         String
  value         Float     @default(0)
  currency      String    @default("USD")
  status        String    @default("OPEN") // OPEN, WON, LOST
  stage         String    @default("PROSPECTING") // PROSPECTING, QUALIFICATION, PROPOSAL, NEGOTIATION, CLOSED
  probability   Int       @default(50)
  expectedClose DateTime?
  assignedTo    String?
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead   Lead?   @relation(fields: [leadId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  quotes Quote[]

  @@index([tenantId])
  @@index([customerId])
}

model Quote {
  id            String   @id @default(cuid())
  tenantId      String
  quoteNumber   String
  opportunityId String?
  customerId    String
  userId        String
  date          DateTime
  validUntil    DateTime
  status        String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED
  subtotal      Float
  discount      Float    @default(0)
  tax           Float    @default(0)
  total         Float
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  items       QuoteItem[]
  orders      SalesOrder[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([customerId])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  productId   String
  productName String
  variantId   String?
  quantity    Int
  unitPrice   Float
  discount    Float  @default(0)
  total       Float

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Activity {
  id            String    @id @default(cuid())
  tenantId      String
  leadId        String?
  opportunityId String?
  customerId    String?
  type          String    // CALL, EMAIL, MEETING, NOTE, TASK
  subject       String
  notes         String?
  dueAt         DateTime?
  completedAt   DateTime?
  userId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([leadId])
  @@index([opportunityId])
}

model SalesOrder {
  id                String   @id @default(cuid())
  tenantId          String
  orderNumber       String
  customerId        String
  userId            String
  quoteId           String?
  warehouseId       String?
  branchId          String?  // gateway Branch.id (optional multi-branch)
  workflowId        String?  // OrderWorkflow — tenant lifecycle template instance
  date              DateTime
  deliveryDate      DateTime?
  status            String   @default("DRAFT")
  // Trading OMS coarse statuses: DRAFT | CONFIRMED | FULFILLING | READY_FOR_DISPATCH |
  // DISPATCHED | DELIVERED | INVOICED | PAID | CLOSED | CANCELLED
  // Grocery template uses its own statuses. Do not add per-customer statuses in code.
  isOnlineOrder     Boolean  @default(false)
  deliveryAddressId String?  // ref: CustomerAddress.id
  deliveryAddressText String? // free-text when address master not used
  deliveryFee       Float    @default(0)
  paymentMethod     String   @default("COD") // COD | UPI | CARD | WALLET | SPLIT
  paymentStatus     String   @default("PENDING") // PENDING | PAID | REFUNDED | PARTIAL
  couponId          String?
  couponDiscount    Float    @default(0)
  subtotal          Float
  tax               Float    @default(0)
  total             Float
  notes             String?
  salesRemarks      String?
  dispatchRemarks   String?
  // Order-level pricing (Pricing Executive)
  purchaseSubtotal     Float @default(0)
  discountAmount       Float @default(0)
  transportationCharge Float @default(0)
  additionalCharges    Float @default(0)
  marginAmount         Float @default(0)
  marginPercent        Float @default(0)
  assignedDriverId     String?
  vehicleInfo          String?
  trackingNumber       String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  closedAt             DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer         Customer             @relation(fields: [customerId], references: [id])
  quote            Quote?               @relation(fields: [quoteId], references: [id])
  salesRequest     SalesRequest?
  workflow         OrderWorkflow?       @relation(fields: [workflowId], references: [id])
  workflowInstance WorkflowInstance?
  items            SalesOrderItem[]
  returns          SalesReturn[]
  modifications    OrderModification[]
  documents        OrderDocument[]
  workflowTasks    WorkflowTask[]
  workflowEvents   WorkflowEvent[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, branchId])
  @@index([workflowId])
}

/// Tenant-scoped order lifecycle (copied from a platform template on apply).
model OrderWorkflow {
  id          String   @id @default(cuid())
  tenantId    String
  templateId  String   // workflow.oms_trading | workflow.grocery_delivery | custom
  code        String   // stable per tenant e.g. OMS_TRADING
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps  OrderWorkflowStep[]
  orders SalesOrder[]
  workflowInstances WorkflowInstance[]

  @@unique([tenantId, code])
  @@index([tenantId, isDefault])
  @@index([tenantId, isActive])
}

/// One allowed transition / stage in a workflow.
model OrderWorkflowStep {
  id           String  @id @default(cuid())
  tenantId     String
  workflowId   String
  key          String  // sales_review, inventory, ...
  label        String  // UI label
  action       String  // PATCH ?action= value
  fromStatuses  Json    // string[] — statuses where this action is allowed
  toStatus     String? // static next status; null if resolverKey / prep-gate handles it
  resolverKey  String? // stock_verify | prep_gate | ship | null
  sortOrder    Int     @default(0)
  roleHint     String? // SALES_EXECUTIVE | PRICING_EXECUTIVE | ...
  uiPanel      String  @default("none") // none | stock | pricing | dispatch | document
  phase        String  @default("FULFILL") // PREP | FULFILL | CLOSE
  dependsOn    Json    @default("[]") // string[] of step keys that must be COMPLETED
  required     Boolean @default(true) // if false, omitted from READY_FOR_DISPATCH gate unless activated
  isTerminal   Boolean @default(false)
  allowCancel  Boolean @default(true)

  workflow OrderWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, key])
  @@unique([workflowId, action])
  @@index([tenantId, workflowId])
}

/// Runtime process execution for a single order against a workflow definition.
model WorkflowInstance {
  id              String   @id @default(cuid())
  tenantId        String
  salesOrderId    String   @unique
  workflowId      String
  currentStatus   String
  currentStepKey  String?
  /// Platform v5+: entity binding (defaults to SALES_ORDER for legacy rows)
  entityType      String   @default("SALES_ORDER")
  entityId        String?
  templateCode    String?
  templateVersion Int?
  /// Immutable published WorkflowDefinition JSON at start
  snapshot        Json?
  variables       Json     @default("{}")
  instanceStatus  String   @default("RUNNING") // RUNNING | COMPLETED | CANCELLED
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order    SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  workflow OrderWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks    WorkflowTask[]
  events   WorkflowEvent[]

  @@index([tenantId, workflowId])
  @@index([tenantId, currentStatus])
  @@index([tenantId, entityType, entityId])
}

model WorkflowTask {
  id                 String   @id @default(cuid())
  tenantId           String
  workflowInstanceId String
  salesOrderId       String
  stepKey            String
  action             String
  title              String
  assignedRole       String
  assignedUserId     String?
  status             String   @default("PENDING") // WAITING | READY | CLAIMED | PENDING | IN_PROGRESS | COMPLETED | CANCELLED | SKIPPED | DEAD_LETTER
  phase              String   @default("FULFILL") // PREP | FULFILL | CLOSE
  dependsOn          Json     @default("[]")
  required           Boolean  @default(true)
  dueAt              DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  completedBy        String?
  payload            Json?
  /// Platform v5 fields
  taskType           String?
  kind               String?  // HUMAN | SYSTEM
  optional           Boolean  @default(false)
  claimedAt          DateTime?
  leaseExpiresAt     DateTime?
  attempt            Int      @default(0)
  rowVersion         Int      @default(1)
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  order            SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId, action, status])
  @@index([tenantId, assignedRole, status])
  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, phase, status])
  @@index([tenantId, status, leaseExpiresAt])
}

model WorkflowEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  workflowInstanceId String
  salesOrderId       String
  type               String   // TASK_CREATED | TASK_COMPLETED | STATUS_SYNC | TRANSITION | INTEGRATION
  stepKey            String?
  action             String?
  fromStatus         String?
  toStatus           String?
  actorUserId        String?
  actorRole          String?
  remarks            String?
  payload            Json?
  createdAt          DateTime @default(now())

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  order            SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowInstanceId, createdAt])
  @@index([tenantId, salesOrderId, createdAt])
}

model SalesOrderItem {
  id            String  @id @default(cuid())
  salesOrderId  String
  productId     String
  productName   String
  variantId     String?
  quantity      Int
  shippedQty    Int     @default(0)
  availableQty  Float?  // manual stock verification
  shortageQty   Float?  // max(0, quantity - availableQty)
  unitPrice     Float
  purchasePrice Float?
  discount      Float   @default(0)
  taxRate       Float   @default(0)
  total         Float
  customSnapshot Json?  // product customAttributes at order time
  remarks       String?

  order       SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  returnItems SalesReturnItem[]
}

model OrderModification {
  id           String   @id @default(cuid())
  tenantId     String
  salesOrderId String
  userId       String
  action       String   // REVIEW_EDIT | STOCK_VERIFY | PRICING | DISPATCH | STATUS_CHANGE | ITEM_ADD | ITEM_REMOVE | ITEM_UPDATE
  field        String?
  oldValue     String?
  newValue     String?
  remarks      String?
  createdAt    DateTime @default(now())

  order SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, salesOrderId])
}

model OrderDocument {
  id           String   @id @default(cuid())
  tenantId     String
  salesOrderId String
  type         String   // ACKNOWLEDGEMENT | DELIVERY_PROOF | INVOICE | OTHER
  fileName     String
  fileUrl      String
  mimeType     String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  order SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, salesOrderId])
}

model SalesReturn {
  id           String   @id @default(cuid())
  tenantId     String
  returnNumber String
  orderId      String
  customerId   String
  userId       String
  status       String   @default("PENDING") // PENDING, APPROVED, COMPLETED, REJECTED
  reason       String?
  notes        String?
  subtotal     Float
  tax          Float    @default(0)
  total        Float
  creditNoteId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order    SalesOrder        @relation(fields: [orderId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])
  items    SalesReturnItem[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([customerId])
}

model SalesReturnItem {
  id          String @id @default(cuid())
  returnId    String
  orderItemId String
  productId   String
  productName String
  variantId   String?
  quantity    Int
  unitPrice   Float
  total       Float

  return    SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem SalesOrderItem @relation(fields: [orderItemId], references: [id])
}

/// Versioned workflow definition JSON (designer authoring + publish). Runtime snapshots copy this.
model WorkflowTemplateVersion {
  id           String   @id @default(cuid())
  tenantId     String
  templateCode String   // e.g. SO_STANDARD
  version      Int
  lifecycle    String   // DRAFT | PUBLISHED | ARCHIVED
  name         String?
  definition   Json     // WorkflowDefinition JSON — source of truth
  clonedFromId String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, templateCode, version])
  @@index([tenantId, templateCode, lifecycle])
  @@index([tenantId, lifecycle])
}

/// Independently versioned FORM metadata (Phase 1 typed catalog; not unified MetadataAsset yet).
model WorkflowFormVersion {
  id         String   @id @default(cuid())
  tenantId   String
  formId     String   // stable catalog id e.g. sales-review
  version    Int
  lifecycle  String   // DRAFT | PUBLISHED | ARCHIVED
  name       String?
  definition Json     // FormDefinition JSON
  clonedFromId String?
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, formId, version])
  @@index([tenantId, formId, lifecycle])
  @@index([tenantId, lifecycle])
}

/// Dependency index: which workflow versions reference which assets (impact analysis).
model WorkflowAssetDependency {
  id                 String   @id @default(cuid())
  tenantId           String
  /// Asset being referenced (e.g. FORM)
  assetType          String
  assetId            String
  assetVersion       Int
  /// Consumer (Phase 1: WORKFLOW template versions)
  consumerType       String   // WORKFLOW
  consumerId         String   // templateCode
  consumerVersion    Int
  consumerRecordId   String?  // WorkflowTemplateVersion.id
  createdAt          DateTime @default(now())

  @@unique([tenantId, assetType, assetId, assetVersion, consumerType, consumerId, consumerVersion])
  @@index([tenantId, assetType, assetId])
  @@index([tenantId, consumerType, consumerId, consumerVersion])
}
