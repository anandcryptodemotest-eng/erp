# Shared Next.js standalone image for ERP backends.
# Build from repo root:
#   docker build -f docker/Dockerfile.next --build-arg APP_NAME=sales --build-arg APP_PORT=3001 -t erp-sales .
ARG NODE_VERSION=20

FROM node:${NODE_VERSION}-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile

FROM deps AS builder
ARG APP_NAME
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# Generate prisma client for the target app when schema exists
RUN if [ -f "apps/${APP_NAME}/prisma/schema.prisma" ]; then \
      pnpm --filter "@erp/${APP_NAME}" exec prisma generate; \
    fi
RUN pnpm --filter "@erp/${APP_NAME}" build

FROM node:${NODE_VERSION}-alpine AS runner
ARG APP_NAME
ARG APP_PORT=3000
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=${APP_PORT}
ENV HOSTNAME=0.0.0.0
ENV SERVICE_NAME=${APP_NAME}

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

# Next standalone output
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

USER nextjs
EXPOSE ${APP_PORT}
CMD node apps/${APP_NAME}/server.js
