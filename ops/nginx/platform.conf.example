# Platform Admin — nginx only (do not publish :3011).
#
# App: next.dev/start --hostname 127.0.0.1 --port 3011 with basePath /platform
# Public URL: https://HOST/platform/login
# APIs: /api/platform/* → gateway (existing /api/ location)

upstream erp_platform {
    server 127.0.0.1:3011;
    keepalive 8;
}

