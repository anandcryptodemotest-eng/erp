{
  "name": "erp",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:gateway": "turbo dev --filter=@erp/gateway",
    "dev:web": "turbo dev --filter=@erp/web",
    "dev:sales": "turbo dev --filter=@erp/sales",
    "dev:inventory": "turbo dev --filter=@erp/inventory",
    "dev:accounting": "turbo dev --filter=@erp/accounting",
    "dev:hr": "turbo dev --filter=@erp/hr",
    "dev:procurement": "turbo dev --filter=@erp/procurement",
    "dev:delivery": "turbo dev --filter=@erp/delivery",
    "dev:pos": "turbo dev --filter=@erp/pos",
    "dev:platform": "turbo dev --filter=@erp/platform",
    "seed:platform": "pnpm --filter @erp/gateway seed:platform",
    "smoke:platform-admin": "tsx scripts/smoke-platform-admin.ts",
    "e2e:users": "bash scripts/e2e-user-flows.sh",
    "e2e:oms": "pnpm --filter @erp/scripts e2e:oms",
    "seed:demo": "pnpm --filter @erp/scripts seed:demo",
    "arch:fitness": "node scripts/architecture-fitness.cjs",
    "smoke:foundation": "node scripts/smoke-platform-foundation.cjs",
    "smoke:otel-slice": "node scripts/smoke-otel-vertical-slice.cjs",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:obs": "docker compose up -d otel-collector tempo loki prometheus grafana promtail",
    "docker:obs:down": "docker compose stop otel-collector tempo loki prometheus grafana promtail"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
